# Doxyfile 1.15.0

PROJECT_NAME           = "CI Lab"
PROJECT_BRIEF          = "CI Lab reference documentation"
OUTPUT_DIRECTORY       = build/docs

GENERATE_HTML          = YES
HTML_OUTPUT            = html

GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

QUIET                  = YES
WARN_AS_ERROR          = NO

RECURSIVE              = YES
INPUT                  = include src
FILE_PATTERNS          = *.h *.c

EXCLUDE                = include/argparse src/argparse build bin test_output testcases
EXCLUDE_PATTERNS       = */.git/*

GENERATE_TREEVIEW      = YES

HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_LOCAL_CLASSES  = YES

SOURCE_BROWSER         = NO
VERBATIM_HEADERS = NO
INLINE_SOURCES         = NO
